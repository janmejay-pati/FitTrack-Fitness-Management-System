@model IEnumerable<GYM_Management_System.Models.WorkoutPlan>

@{
    ViewBag.Title = "Workout Plans";
}

<h2 class="page-title">Workout Plans</h2>

<div class="add-button">
    @Html.ActionLink("➕ Create New Workout Plan", "Create", null, new { @class = "btn-primary" })
</div>

<div class="cards-container">
    @foreach (var plan in Model)
    {
        <div class="card">
            <div class="card-header">
                <span class="workout-icon">@GetWorkoutIcon(plan.IntensityLevel)</span>
                <span class="plan-title">@plan.PlanName</span>
            </div>
            <div class="card-body">
                <p>@plan.Description</p>
                <p><strong>Intensity Level:</strong> @plan.IntensityLevel</p>
                <p><strong>BMI Category:</strong> @plan.BmiCategory</p>
            </div>
            <div class="card-footer">
                @Html.ActionLink("Edit", "Edit", new { id = plan.Id }, new { @class = "card-link" }) |
                @Html.ActionLink("Details", "Details", new { id = plan.Id }, new { @class = "card-link" }) |
                @Html.ActionLink("Delete", "Delete", new { id = plan.Id }, new { @class = "card-link text-danger" })
            </div>
        </div>
    }
</div>

@helper GetWorkoutIcon(string intensity)
{
    switch (intensity)
    {
        case "Low":
            @: 🧘‍♂
            break;
        case "Medium":
            @: ‍♂
            break;
        case "High":
            @: 🏋
            break;
        case "Extreme":
            @: ‍♂
            break;
        default:
            @: 🏃
            break;
    }
}

<style>
    .add-button {
        text-align: right;
        margin-bottom: 20px;
    }

    .cards-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .card-header {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
    }

    .workout-icon {
        font-size: 28px;
        margin-right: 10px;
    }

    .plan-title {
        flex-grow: 1;
    }

    .card-body p {
        margin: 6px 0;
    }

    .card-footer {
        margin-top: 12px;
    }

    .card-link {
        margin-right: 10px;
        text-decoration: none;
        color: #007bff;
    }

        .card-link:hover {
            text-decoration: underline;
        }

    .text-danger {
        color: #dc3545;

    }
</style>
