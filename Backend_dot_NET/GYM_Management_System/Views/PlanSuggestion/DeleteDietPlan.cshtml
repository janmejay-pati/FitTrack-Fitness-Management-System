@model GYM_Management_System.Models.DietPlan

@{
    ViewBag.Title = "Delete Diet Plan";
}

<h2 class="page-title" style="color: #ff4c4c;">Delete Diet Plan</h2>

<div class="form-container">
    <h4>Are you sure you want to delete this plan?</h4>
    <div class="plan-summary">
        <strong>Plan Name:</strong> @Html.DisplayFor(m => m.PlanName) <br />
        <strong>Meal Type:</strong> @Html.DisplayFor(m => m.MealType) <br />
        <strong>BMI Category:</strong> @Html.DisplayFor(m => m.BmiCategory)
    </div>

    @using (Html.BeginForm())
    {
        <button type="submit" class="btn-danger">Yes, Delete</button>
        @Html.ActionLink("Cancel", "CreateDietPlan", null, new { @class = "btn-secondary" })
    }
</div>

<style>
    .btn-danger {
        background-color: #e60000;
        color: white;
        padding: 10px 22px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        margin-top: 15px;
        margin-right: 10px;
        cursor: pointer;
    }

    .btn-secondary {
        background-color: #808080;
        color: white;
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 16px;

    }
</style>
