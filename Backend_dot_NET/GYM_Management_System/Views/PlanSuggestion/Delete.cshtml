@model GYM_Management_System.Models.WorkoutPlan
@{
    ViewBag.Title = "Delete Workout Plan";
}

<div class="delete-box">
    <h2>Are you sure you want to delete this plan?</h2>
    <h4>@Model.PlanName</h4>
    <p><strong>Description:</strong> @Model.Description</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <button type="submit" class="btn-delete">Yes, Delete</button>
        <a href="@Url.Action("Index")" class="btn-cancel">Cancel</a>
    }
</div>

<style>
    .delete-box {
        max-width: 600px;
        margin: 40px auto;
        padding: 30px;
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    h2 {
        color: #dc3545;
        margin-bottom: 10px;
    }

    h4 {
        margin-bottom: 20px;
    }

    .btn-delete {
        background-color: #dc3545;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        border: none;
        font-weight: bold;
        margin-right: 10px;
    }

    .btn-cancel {
        background-color: #6c757d;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-delete:hover,
        .btn-cancel:hover {
            opacity: 0.9;

        }
</style>
