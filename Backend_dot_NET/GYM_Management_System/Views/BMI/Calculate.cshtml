<div class="bmi-form">
    <form method="post">
        <label>Height (meters):</label>
        <input type="number" step="0.01" name="Height" required placeholder="0.01" />

        <label>Weight (kg):</label>
        <input type="number" step="0.1" name="Weight" required placeholder="0.1" />

        <button type="submit" class="btn-calculate">Calculate BMI</button>
    </form>
</div>

<a href="@Url.Action("Index", "BMI")" class="btn-back">View BMI History</a>

<style>
    .title {
        text-align: center;
        color: #333;
        margin-bottom: 20px;
    }

    .bmi-form {
        max-width: 400px;
        margin: auto;
        padding: 20px;
        background: white;
        box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    label {
        display: block;
        margin: 10px 0 5px;
        font-weight: bold;
    }

    input {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .btn-calculate {
        width: 100%;
        padding: 10px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 5px;
        margin-top: 10px;
    }

    .btn-back {
        display: block;
        text-align: center;
        margin: 10px auto;
        color: #007bff;
        text-decoration: none;

    }
</style>