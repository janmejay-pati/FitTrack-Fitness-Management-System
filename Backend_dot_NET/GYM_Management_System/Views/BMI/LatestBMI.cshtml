@model GYM_Management_System.Models.BMImodel
@{
    ViewBag.Title = "Latest Biometric Assessment";
    double score = ViewBag.BMIScore ?? (Model != null ? Model.BMIscore : 22.0);
    string category = ViewBag.BMICategory ?? "Normal";
    string color = ViewBag.BMIColor ?? "#10b981";
}

<div class="max-w-2xl mx-auto py-12 px-4">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl text-center">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-3xl mb-4">
            <i class="fas fa-check-circle"></i>
        </div>

        <h1 class="text-3xl font-extrabold text-white mb-2">Biometric Evaluation Saved</h1>
        <p class="text-slate-400 text-sm mb-8">Your physical metrics have been synchronized with the intelligence engine.</p>

        <!-- Big Score Card -->
        <div class="p-8 rounded-2xl bg-slate-950/80 border border-slate-800 mb-8">
            <span class="text-xs uppercase font-bold text-slate-500 tracking-wider block mb-2">Calculated Body Mass Index</span>
            <div class="text-6xl font-black font-mono text-white mb-3">@score.ToString("F1")</div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold border" style="color: @color; border-color: @color; background-color: @(color)22;">
                @category
            </span>
            @if (Model != null && !string.IsNullOrEmpty(Model.HealthStatus))
            {
                <p class="text-slate-400 text-sm mt-4 max-w-md mx-auto">@Model.HealthStatus</p>
            }
        </div>

        <div class="flex items-center justify-center gap-4">
            <a href="@Url.Action("Suggestion", "PlanSuggestion")" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold text-sm hover:shadow-lg hover:shadow-emerald-500/25 transition">
                <i class="fas fa-lightbulb mr-1.5"></i> View Suggested Plans
            </a>
            <a href="@Url.Action("Index", "BMI")" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition">
                View History
            </a>
        </div>
    </div>
</div>
