@model GYM_Management_System.Models.BMImodel
@{
    ViewBag.Title = "Add BMI";
}
<h2>Add BMI</h2>

@using (Html.BeginForm())
{
    <div class="card">
        <div class="form-group">
            @Html.Label("Height (cm)")
            @Html.TextBoxFor(m => m.Height, new { @class = "form-control", placeholder = "Enter height in cm" })
        </div>
        <div class="form-group">
            @Html.Label("Weight (kg)")
            @Html.TextBoxFor(m => m.Weight, new { @class = "form-control", placeholder = "Enter weight in kg" })
        </div>
        <button type="submit" class="btn-modern">Submit</button>
    </div>
    <style>
        .card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 0 12px rgba(0,0,0,0.08);
            padding: 20px;
            margin: 20px 0;
        }

            .card h2 {
                font-size: 22px;
                margin-bottom: 10px;
            }

        .form-group {
            margin-bottom: 15px;
        }

        .btn-modern {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .btn-modern:hover {
                background-color:   #45a049;
            }

    </style>
}
