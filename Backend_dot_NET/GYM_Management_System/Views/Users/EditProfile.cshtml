@model GYM_Management_System.Models.Users_Table
@{
    ViewBag.Title = "Edit Profile";
}

<div class="max-w-xl mx-auto py-12 px-4">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-white">Update Member Profile</h1>
        <p class="text-slate-400 text-sm mt-1">Keep your demographic and biometric information fresh</p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl">
        @using (Html.BeginForm("EditProfile", "Users", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.UserId)
            @Html.HiddenFor(model => model.UserPassword)
            @Html.HiddenFor(model => model.CreatedAt)
            @Html.HiddenFor(model => model.Role)

            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Full Name</label>
                @Html.TextBoxFor(model => model.UserName, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
            </div>

            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Email Address</label>
                @Html.TextBoxFor(model => model.UserEmail, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none", type = "email" })
            </div>

            <div class="grid grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Age</label>
                    @Html.TextBoxFor(model => model.UserAge, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none", type = "number" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Gender</label>
                    @Html.DropDownListFor(model => model.UserGender,
                         new SelectList(new[] { "Male", "Female", "Other" }, Model.UserGender),
                         new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-8">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Height (cm)</label>
                    @Html.TextBoxFor(model => model.Height, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none", type = "number", step = "0.1" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Weight (kg)</label>
                    @Html.TextBoxFor(model => model.Weight, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none", type = "number", step = "0.1" })
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button type="submit" class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold text-sm hover:shadow-lg hover:shadow-emerald-500/25 transition">
                    Save Changes
                </button>
                <a href="@Url.Action("Profile", "Users")" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition">
                    Cancel
                </a>
            </div>
        }
    </div>
</div>
