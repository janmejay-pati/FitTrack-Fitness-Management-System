@model GYM_Management_System.Models.Users_Table
@{
    ViewBag.Title = "Sign In";
    Layout = null; // Standalone auth page
    var errorMsg = ViewBag.ErrorMessage?.ToString() ?? TempData["ErrMsg"]?.ToString() ?? TempData["ErrorMessage"]?.ToString();
    if (!string.IsNullOrEmpty(errorMsg))
    {
        errorMsg = System.Text.RegularExpressions.Regex.Replace(errorMsg, @"<script.*?</script>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - FitTrack Platform</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --ft-bg-base: #070b14;
            --ft-bg-surface: #0f172a;
            --ft-bg-card: rgba(17, 24, 39, 0.85);
            --ft-border: rgba(255, 255, 255, 0.08);
            --ft-border-focus: rgba(16, 185, 129, 0.5);
            --ft-primary: #10b981;
            --ft-primary-hover: #059669;
            --ft-primary-glow: rgba(16, 185, 129, 0.3);
            --ft-cyan: #06b6d4;
            --ft-rose: #f43f5e;
            --ft-text-primary: #f8fafc;
            --ft-text-secondary: #94a3b8;
            --ft-text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--ft-bg-base);
            color: var(--ft-text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 24px;
        }

        /* Ambient Glow Effects */
        .ambient-glow {
            position: fixed;
            pointer-events: none;
            border-radius: 50%;
            filter: blur(140px);
            opacity: 0.35;
            z-index: 0;
        }
        .glow-1 {
            top: -100px;
            left: 20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--ft-primary), transparent 70%);
        }
        .glow-2 {
            bottom: -100px;
            right: 20%;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, var(--ft-cyan), transparent 70%);
        }

        .auth-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
            background: var(--ft-bg-card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--ft-border);
            border-radius: 24px;
            padding: 40px 36px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px rgba(16, 185, 129, 0.08);
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .brand-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--ft-primary), var(--ft-cyan));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #042f20;
            font-size: 1.6rem;
            margin-bottom: 14px;
            box-shadow: 0 6px 20px var(--ft-primary-glow);
        }

        .brand-title {
            font-size: 1.65rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #fff;
            margin-bottom: 6px;
        }

        .brand-subtitle {
            font-size: 0.92rem;
            color: var(--ft-text-secondary);
        }

        /* Demo Quick Login Chips */
        .demo-bar {
            background: rgba(255, 255, 255, 0.04);
            border: 1px dashed var(--ft-border);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 22px;
            text-align: center;
        }

        .demo-bar-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--ft-text-muted);
            margin-bottom: 8px;
        }

        .demo-btn-group {
            display: flex;
            gap: 8px;
        }

        .btn-demo-chip {
            flex: 1;
            padding: 7px 10px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            border-radius: 8px;
            color: #10b981;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-demo-chip:hover {
            background: rgba(16, 185, 129, 0.2);
            border-color: #10b981;
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-demo-chip.admin {
            background: rgba(6, 182, 212, 0.1);
            border-color: rgba(6, 182, 212, 0.25);
            color: var(--ft-cyan);
        }

        .btn-demo-chip.admin:hover {
            background: rgba(6, 182, 212, 0.2);
            border-color: var(--ft-cyan);
            color: #fff;
        }

        /* Form Inputs */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--ft-text-secondary);
            margin-bottom: 7px;
        }

        .input-group-custom {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            color: var(--ft-text-muted);
            font-size: 0.95rem;
            pointer-events: none;
            transition: color 0.2s;
        }

        .form-control-custom {
            width: 100%;
            padding: 13px 14px 13px 42px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--ft-border);
            border-radius: 12px;
            color: #fff;
            font-size: 0.92rem;
            font-family: inherit;
            transition: all 0.2s;
        }

        .form-control-custom:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.07);
            border-color: var(--ft-primary);
            box-shadow: 0 0 0 3px var(--ft-primary-glow);
        }

        .form-control-custom:focus + .input-icon {
            color: var(--ft-primary);
        }

        .toggle-password {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            color: var(--ft-text-muted);
            cursor: pointer;
            padding: 4px;
            font-size: 0.95rem;
        }

        .toggle-password:hover {
            color: #fff;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-hover) 100%);
            color: #042f20;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            box-shadow: 0 6px 20px var(--ft-primary-glow);
            transition: all 0.2s;
            margin-top: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
            color: #021f14;
        }

        /* Alert Banner */
        .ft-alert {
            background: rgba(244, 63, 94, 0.12);
            border: 1px solid rgba(244, 63, 94, 0.3);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #fecdd3;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .auth-footer {
            margin-top: 24px;
            text-align: center;
            font-size: 0.88rem;
            color: var(--ft-text-secondary);
        }

        .auth-footer a {
            color: var(--ft-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--ft-text-muted);
            font-size: 0.85rem;
            text-decoration: none;
            margin-top: 18px;
            transition: color 0.2s;
        }

        .back-home:hover {
            color: var(--ft-text-primary);
        }
    </style>
</head>
<body>
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="auth-card">
        <!-- Brand Header -->
        <div class="brand-header">
            <div class="brand-icon-box">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <h1 class="brand-title">Welcome Back</h1>
            <p class="brand-subtitle">Sign in to access your fitness intelligence</p>
        </div>

        <!-- Quick 1-Click Demo Login Bar -->
        <div class="demo-bar">
            <div class="demo-bar-title"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> Quick Test Credentials</div>
            <div class="demo-btn-group">
                <button type="button" class="btn-demo-chip" onclick="fillAndSubmit('alex@fittrack.com', 'User@123')">
                    <i class="fa-solid fa-user"></i> Demo User
                </button>
                <button type="button" class="btn-demo-chip admin" onclick="fillAndSubmit('admin@fittrack.com', 'Admin@123')">
                    <i class="fa-solid fa-shield-halved"></i> Demo Admin
                </button>
            </div>
        </div>

        <!-- Inline Error Banner -->
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="ft-alert">
                <i class="fa-solid fa-circle-exclamation text-danger fs-5"></i>
                <div>@errorMsg</div>
            </div>
        }

        <!-- Login Form -->
        <form method="post" action="/Users/Login" id="loginForm">
            <div class="form-group">
                <label class="form-label" for="Email">Email Address</label>
                <div class="input-group-custom">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" id="Email" name="Email" class="form-control-custom" placeholder="name@example.com" required autocomplete="email" />
                </div>
            </div>

            <div class="form-group">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0" for="Password">Password</label>
                    <a href="/Users/ChangePassword" style="font-size: 0.78rem; color: var(--ft-text-muted); text-decoration: none;">Forgot password?</a>
                </div>
                <div class="input-group-custom">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" id="Password" name="Password" class="form-control-custom" placeholder="••••••••" required autocomplete="current-password" />
                    <button type="button" class="toggle-password" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
                        <i class="fa-regular fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-submit" id="btnSubmit">
                <span>Sign In to Dashboard</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            Don't have an account? <a href="/Users/Register">Create an account</a>
            <div class="mt-2">
                <a href="/Admin/AdminLogin" style="color: var(--ft-text-muted); font-size: 0.8rem;">
                    <i class="fa-solid fa-lock me-1"></i> Administrator Portal Access
                </a>
            </div>
        </div>

        <div class="text-center">
            <a href="/" class="back-home">
                <i class="fa-solid fa-arrow-left"></i> Return to Homepage
            </a>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("Password");
            var icon = document.getElementById("toggleIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        function fillAndSubmit(email, password) {
            document.getElementById("Email").value = email;
            document.getElementById("Password").value = password;
            var btn = document.getElementById("btnSubmit");
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Authenticating...';
            btn.disabled = true;
            document.getElementById("loginForm").submit();
        }
    </script>
</body>
</html>
