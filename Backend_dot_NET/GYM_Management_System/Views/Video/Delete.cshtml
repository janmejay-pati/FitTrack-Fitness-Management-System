@model GYM_Management_System.Models.VideoTutorials

@{
    ViewBag.Title = "Delete Video";
}

<h2 class="page-title">Delete Video</h2>

<div class="form-container">
    <h3>Are you sure you want to delete this video?</h3>

    <div class="form-group">
        <strong>Title:</strong> @Html.DisplayFor(model => model.Title)
    </div>

    <div class="form-group">
        <strong>Category:</strong> @Html.DisplayFor(model => model.Category)
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <button type="submit" class="submit-btn">Delete</button>
        <a href="@Url.Action("Index")" class="cancel-btn">Cancel</a>
    }
</div>
