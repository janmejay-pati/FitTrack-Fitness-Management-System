<title>Sign Up - FitTrack</title>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #f0f4f8;
        height: 100vh;
    }

    .signup-container {
        margin-left: 400px;
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 400px;
    }

        .signup-container h2 {
            margin-bottom: 25px;
            color: #0071bc;
            text-align: center;
        }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="number"] {
        width: 100%;
        padding: 14px;
        margin-bottom: 15px;
        border: 1px solid #ccc;
        border-radius: 10px;
        font-size: 14px;
    }

    button {
        width: 100%;
        padding: 14px;
        background-color: #0071bc;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        button:hover {
            background-color: #005f99;
        }

    .switch-auth {
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
    }

        .switch-auth a {
            color: #0071bc;
            text-decoration: none;
        }

    .logo {
        margin-left: 100px;
        margin-bottom: 20px;
    }

        .logo img {
            width: 100px;
            border: 3px solid #0071bc;
            border-radius: 50%;
        }
</style>
<div class="signup-container">
    <div class="logo">
        <img src="~/Images/LogoImage.png" alt="FitTrack Logo" />
    </div>
    <h2>Create Your Account</h2>
    <form method="post" action="/Admin/Create">
        <input type="text" name="Name" placeholder="Full Name" required>
        <input type="email" name="Email" placeholder="Email Address" required>
        <input type="password" name="Password" placeholder="Password" required>   
        <button type="submit">Sign Up</button>
    </form>
    <div class="switch-auth">
        Already have an account? <a href="/Admin/AdminLogin">Log In</a>
    </div>
</div>
