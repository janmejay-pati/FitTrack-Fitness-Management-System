@model GYM_Management_System.Models.Admin
@{
    ViewBag.Title = "Admin Command Portal";
}

<div class="max-w-5xl mx-auto py-12 px-4">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 md:p-10 shadow-2xl">
        <div class="flex flex-col md:flex-row items-center gap-6 mb-8 pb-8 border-b border-slate-800">
            <div class="w-20 h-20 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 text-3xl">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="text-center md:text-left flex-1">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20 inline-block mb-2">
                    System Administrator
                </span>
                <h1 class="text-3xl font-black text-white">@Model.Name</h1>
                <p class="text-slate-400 text-sm font-mono mt-1">@Model.Email</p>
            </div>
            <a href="@Url.Action("AdminLogin", "Admin")" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition">
                Switch Admin Session
            </a>
        </div>

        <h3 class="text-lg font-bold text-white mb-6">Management Consoles</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="@Url.Action("Index", "PlanSuggestion")" class="p-6 rounded-2xl bg-slate-950/60 hover:bg-slate-800/60 border border-slate-800 hover:border-emerald-500/40 transition block">
                <i class="fas fa-dumbbell text-emerald-400 text-2xl mb-3 block"></i>
                <h4 class="text-white font-bold text-base mb-1">Workout Plans</h4>
                <p class="text-slate-400 text-xs">Create, edit and manage workout suggestions</p>
            </a>

            <a href="@Url.Action("DietPlanIndex", "PlanSuggestion")" class="p-6 rounded-2xl bg-slate-950/60 hover:bg-slate-800/60 border border-slate-800 hover:border-amber-500/40 transition block">
                <i class="fas fa-utensils text-amber-400 text-2xl mb-3 block"></i>
                <h4 class="text-white font-bold text-base mb-1">Diet Plans</h4>
                <p class="text-slate-400 text-xs">Curate nutrition protocols for each BMI category</p>
            </a>

            <a href="@Url.Action("Index", "Dashboard")" class="p-6 rounded-2xl bg-slate-950/60 hover:bg-slate-800/60 border border-slate-800 hover:border-cyan-500/40 transition block">
                <i class="fas fa-chart-line text-cyan-400 text-2xl mb-3 block"></i>
                <h4 class="text-white font-bold text-base mb-1">Live Dashboard</h4>
                <p class="text-slate-400 text-xs">View platform activity and telemetry metrics</p>
            </a>
        </div>
    </div>
</div>
