@model GYM_Management_System.Models.Admin
@{
    ViewBag.Title = "Admin Portal Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var errorMsg = ViewBag.ErrorMessage?.ToString() ?? TempData["ErrMsg"]?.ToString();
    if (!string.IsNullOrEmpty(errorMsg))
    {
        errorMsg = System.Text.RegularExpressions.Regex.Replace(errorMsg, @"<script.*?</script>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
    }
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="ft-card p-4 p-md-5" style="max-width: 440px; width: 100%; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; border-radius: 14px; background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--ft-cyan); font-size: 1.5rem;">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h2 class="fw-bold mb-1" style="color: #fff; font-size: 1.6rem;">Administrator Portal</h2>
            <p style="color: var(--ft-text-secondary); font-size: 0.9rem;">Elevated privileges access for system management</p>
        </div>

        <!-- Quick 1-Click Fill -->
        <div class="p-3 mb-4 rounded-3 text-center" style="background: rgba(255, 255, 255, 0.04); border: 1px dashed var(--ft-border);">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--ft-text-muted); text-transform: uppercase; margin-bottom: 8px;">
                <i class="fa-solid fa-key me-1"></i> Quick Admin Access
            </div>
            <button type="button" class="btn btn-sm w-100 fw-bold" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--ft-cyan);" onclick="fillAdmin()">
                <i class="fa-solid fa-bolt me-1"></i> Fill Admin Credentials (admin@fittrack.com)
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="p-3 mb-3 rounded-3 d-flex align-items-center gap-2" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); color: #fecdd3; font-size: 0.88rem;">
                <i class="fa-solid fa-circle-exclamation text-danger fs-5"></i>
                <div>@errorMsg</div>
            </div>
        }

        @using (Html.BeginForm("AdminLogin", "Admin", FormMethod.Post, new { id = "adminLoginForm" }))
        {
            <div class="mb-3">
                <label class="form-label" style="font-size: 0.85rem; font-weight: 600; color: var(--ft-text-secondary);">Administrator Email</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0" style="background: rgba(255,255,255,0.04); border-color: var(--ft-border); color: var(--ft-text-muted);">
                        <i class="fa-regular fa-envelope"></i>
                    </span>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 text-white", placeholder = "admin@fittrack.com", style = "background: rgba(255,255,255,0.04); border-color: var(--ft-border);", id = "AdminEmail", required = "required" })
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label" style="font-size: 0.85rem; font-weight: 600; color: var(--ft-text-secondary);">Password</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0" style="background: rgba(255,255,255,0.04); border-color: var(--ft-border); color: var(--ft-text-muted);">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 text-white", placeholder = "••••••••", style = "background: rgba(255,255,255,0.04); border-color: var(--ft-border);", id = "AdminPassword", required = "required" })
                </div>
            </div>

            <button type="submit" class="btn btn-ft-primary w-100 py-3 justify-content-center">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Authenticate Administrator
            </button>
        }

        <div class="text-center mt-4">
            <a href="/Users/Login" style="color: var(--ft-text-muted); font-size: 0.85rem; text-decoration: none;">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to User Sign In
            </a>
        </div>
    </div>
</div>

<script>
    function fillAdmin() {
        document.getElementById("AdminEmail").value = "admin@fittrack.com";
        document.getElementById("AdminPassword").value = "Admin@123";
    }
</script>
