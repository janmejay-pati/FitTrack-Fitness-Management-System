    <!-- Bootstrap JS & Interactive Calculator Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function calculateLiveBMI() {
            var heightCm = parseFloat(document.getElementById('heightSlider').value);
            var weightKg = parseFloat(document.getElementById('weightSlider').value);

            document.getElementById('heightDisplay').innerText = heightCm + ' cm';
            document.getElementById('weightDisplay').innerText = weightKg + ' kg';

            var heightM = heightCm / 100.0;
            var bmi = (weightKg / (heightM * heightM)).toFixed(1);

            document.getElementById('liveBmiScore').innerText = bmi;

            var catElem = document.getElementById('liveBmiCategory');
            var adviceElem = document.getElementById('liveBmiAdvice');

            if (bmi < 18.5) {
                catElem.innerText = 'Underweight';
                catElem.style.background = 'rgba(6, 182, 212, 0.2)';
                catElem.style.color = '#06b6d4';
                adviceElem.innerText = 'You are currently below standard weight. Aim for a caloric surplus with nutrient-dense meals and progressive resistance training.';
            } else if (bmi < 25.0) {
                catElem.innerText = 'Normal Weight';
                catElem.style.background = 'rgba(16, 185, 129, 0.2)';
                catElem.style.color = '#10b981';
                adviceElem.innerText = 'You are in the optimal healthy weight range. Maintain balanced macros and 150+ minutes of weekly aerobic and resistance activity.';
            } else if (bmi < 30.0) {
                catElem.innerText = 'Overweight';
                catElem.style.background = 'rgba(245, 158, 11, 0.2)';
                catElem.style.color = '#f59e0b';
                adviceElem.innerText = 'Slightly above optimal weight. Focus on a slight caloric deficit (300-500 kcal), portion control, and increasing daily step count.';
            } else {
                catElem.innerText = 'Obese';
                catElem.style.background = 'rgba(244, 63, 94, 0.2)';
                catElem.style.color = '#f43f5e';
                adviceElem.innerText = 'Consult a health professional for personalized guidance. Incorporate low-impact cardio (walking, swimming) and whole-food nutrition.';
            }
        }
    </script>
