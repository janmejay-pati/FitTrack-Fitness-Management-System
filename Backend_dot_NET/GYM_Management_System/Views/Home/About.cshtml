@{
    ViewBag.Title = "About FitTrack Intelligence";
}

<div class="max-w-6xl mx-auto py-12 px-4">
    <!-- Hero Header -->
    <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-4">
            <i class="fas fa-microchip"></i> Modern Fitness Intelligence
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-white mb-6">
            Engineered for <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Peak Athletic Performance</span>
        </h1>
        <p class="text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
            FitTrack combines high-precision biometric telemetry, adaptive workout logging, and intelligent nutritional analytics into an enterprise-grade platform built on ASP.NET MVC 5 and modern responsive architecture.
        </p>
    </div>

    <!-- Core Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/40 transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/5">
            <div class="w-14 h-14 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-2xl mb-6">
                <i class="fas fa-heart-pulse"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Biometric Telemetry</h3>
            <p class="text-slate-400 leading-relaxed text-sm">
                Real-time BMI calculation with automatic unit normalization, metabolic rate analysis, and longitudinal tracking to monitor true body composition progress over time.
            </p>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/40 transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/5">
            <div class="w-14 h-14 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-2xl mb-6">
                <i class="fas fa-fire-burner"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Caloric Equilibrium</h3>
            <p class="text-slate-400 leading-relaxed text-sm">
                Balanced energy accounting synchronizing meal intake, macronutrient breakdowns, and workout expenditure to keep you on targeted fat-loss or muscle-hypertrophy paths.
            </p>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/40 transition-all duration-300 hover:shadow-lg hover:shadow-emerald-500/5">
            <div class="w-14 h-14 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl mb-6">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Enterprise Security</h3>
            <p class="text-slate-400 leading-relaxed text-sm">
                Robust session security, PBKDF2/SHA-256 cryptographic password hashing, role-based access control, and complete per-user database isolation.
            </p>
        </div>
    </div>

    <!-- Tech Stack Specs -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-8 md:p-12 mb-16">
        <h2 class="text-2xl font-bold text-white mb-8 text-center">System Architecture & Tech Stack</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50">
                <div class="text-emerald-400 font-mono text-xl font-bold mb-1">ASP.NET MVC 5</div>
                <div class="text-xs text-slate-400">High-performance C# backend on .NET Framework 4.7.2</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50">
                <div class="text-cyan-400 font-mono text-xl font-bold mb-1">MySQL 8.0</div>
                <div class="text-xs text-slate-400">Relational storage via Entity Framework 6 ORM</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50">
                <div class="text-indigo-400 font-mono text-xl font-bold mb-1">RESTful API</div>
                <div class="text-xs text-slate-400">Dual Web API controllers for native & SPA clients</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/40 border border-slate-700/50">
                <div class="text-amber-400 font-mono text-xl font-bold mb-1">Adaptive Razor</div>
                <div class="text-xs text-slate-400">Responsive Tailwind UI with glassmorphic cards</div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
        <a href="@Url.Action("Register", "Users")" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold hover:shadow-lg hover:shadow-emerald-500/25 transition-all">
            Join FitTrack Today <i class="fas fa-arrow-right"></i>
        </a>
    </div>
</div>
