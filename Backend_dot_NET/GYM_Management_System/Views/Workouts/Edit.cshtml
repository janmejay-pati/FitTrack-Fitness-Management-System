@model GYM_Management_System.Models.Workout
@{
    ViewBag.Title = "Edit Workout";
}

<div class="max-w-xl mx-auto py-12 px-4">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-white">Modify Workout Entry</h1>
        <p class="text-slate-400 text-sm mt-1">Update session parameters and energy expenditure</p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.UserId)

            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Workout Discipline</label>
                @Html.DropDownListFor(m => m.ExerciseType,
                     new SelectList(new[] { "Strength", "Cardio", "HIIT", "Yoga", "Walking", "Cycling", "Swimming" }, Model.ExerciseType),
                     new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
            </div>

            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Exercise Movement</label>
                @Html.TextBoxFor(model => model.Exercise, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Duration (Minutes)</label>
                    @Html.TextBoxFor(model => model.Duration, new { type = "number", @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Calories Burned (kcal)</label>
                    @Html.TextBoxFor(model => model.CaloriesBurned, new { type = "number", @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
                </div>
            </div>

            <div class="mb-8">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Date</label>
                @Html.TextBoxFor(model => model.Date, "{0:yyyy-MM-dd}", new { type = "date", @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-emerald-500 focus:outline-none" })
            </div>

            <div class="flex items-center gap-4">
                <button type="submit" class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold text-sm hover:shadow-lg hover:shadow-emerald-500/25 transition">
                    Update Workout
                </button>
                <a href="@Url.Action("Index")" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition">
                    Cancel
                </a>
            </div>
        }
    </div>
</div>
