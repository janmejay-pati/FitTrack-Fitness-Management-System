@model GYM_Management_System.Models.MealLog

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card p-4 shadow rounded-4">
        <h2 class="text-danger mb-4">Delete Meal</h2>

        <p>Are you sure you want to delete this meal?</p>

        <dl class="row">
            <dt class="col-sm-3">Meal Type</dt>
            <dd class="col-sm-9">@Model.MealType</dd>

            <dt class="col-sm-3">Meal</dt>
            <dd class="col-sm-9">@Model.FoodItems</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

            <dt class="col-sm-3">Calories</dt>
            <dd class="col-sm-9">@Model.Calories</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger rounded-pill">Delete</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        }
    </div>
</div>

