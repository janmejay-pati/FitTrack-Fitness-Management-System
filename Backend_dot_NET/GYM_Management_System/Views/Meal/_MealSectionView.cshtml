@model IEnumerable<GYM_Management_System.Models.MealLog>

@if (!Model.Any())
{
    <p class="no-entries">No entries yet.</p>
}
else
{
    <ul class="meal-list">
        @foreach (var item in Model)
        {
            <li>
                <span>@item.FoodItems - @item.Calories kcal</span>
                <a href="@Url.Action("Details", new { id = item.Id })">Details</a> |
                <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
            </li>
        }
    </ul>
}
<style>
    .meal-form-container {
        max-width: 600px;
        margin: 30px auto;
        padding: 25px;
        background: #f9f9f9;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        .meal-form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 26px;
            color: #333;
        }

    .form-field {
        margin-bottom: 15px;
    }

        .form-field label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-field input,
        .form-field select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background-color: #2c7be5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-submit:hover {
            background-color:   #1a5dc9;
        }
</style>

