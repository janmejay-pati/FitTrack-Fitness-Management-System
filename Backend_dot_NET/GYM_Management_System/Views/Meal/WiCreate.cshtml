@model GYM_Management_System.Models.WaterTntakeLog
@{
    ViewBag.Title = "Log Water Intake";
}

<div class="max-w-md mx-auto py-12 px-4">
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold mb-3">
            <i class="fas fa-droplet"></i> Fluid Intake
        </div>
        <h1 class="text-3xl font-extrabold text-white">Log Water Intake</h1>
        <p class="text-slate-400 text-sm mt-1">Keep hydration optimal for recovery and cognition</p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl">
        <!-- Quick presets -->
        <div class="grid grid-cols-3 gap-3 mb-6">
            <button type="button" onclick="document.getElementById('AmountInMl').value = 250;" class="py-2.5 rounded-xl bg-slate-800 hover:bg-cyan-500/20 border border-slate-700 hover:border-cyan-500/40 text-cyan-400 font-bold text-xs transition">
                +250 ml
            </button>
            <button type="button" onclick="document.getElementById('AmountInMl').value = 500;" class="py-2.5 rounded-xl bg-slate-800 hover:bg-cyan-500/20 border border-slate-700 hover:border-cyan-500/40 text-cyan-400 font-bold text-xs transition">
                +500 ml
            </button>
            <button type="button" onclick="document.getElementById('AmountInMl').value = 750;" class="py-2.5 rounded-xl bg-slate-800 hover:bg-cyan-500/20 border border-slate-700 hover:border-cyan-500/40 text-cyan-400 font-bold text-xs transition">
                +750 ml
            </button>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Quantity in Milliliters (ml)</label>
                @Html.TextBoxFor(m => m.AmountInMl, new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-cyan-500 focus:outline-none", placeholder = "e.g., 500", type = "number", id = "AmountInMl", required = "required" })
            </div>

            <div class="mb-8">
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Date</label>
                @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-cyan-500 focus:outline-none", type = "date" })
            </div>

            <div class="flex items-center gap-4">
                <button type="submit" class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-sm hover:shadow-lg hover:shadow-cyan-500/25 transition">
                    Save Hydration
                </button>
                <a href="@Url.Action("WaterIntakeIndex")" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition">
                    Back
                </a>
            </div>
        }
    </div>
</div>
