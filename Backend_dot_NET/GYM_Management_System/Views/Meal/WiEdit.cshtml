@model GYM_Management_System.Models.WaterTntakeLog
@{
    ViewBag.Title = "Log Water Intake";
}
<h2>@ViewBag.Title</h2>
<div class="form-container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            @Html.LabelFor(m => m.Date)
            @Html.TextBoxFor(m => m.Date, new { @class = "form-control", type = "date" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.AmountInMl)
            @Html.TextBoxFor(m => m.AmountInMl, new { @class = "form-control", placeholder = "Enter quantity in ml" })
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        @Html.ActionLink("Back", "WaterIntakeIndex", null, new { @class = "btn btn-secondary" })
    }
</div>
