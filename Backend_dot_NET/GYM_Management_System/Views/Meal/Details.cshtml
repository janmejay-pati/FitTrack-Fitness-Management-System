@model GYM_Management_System.Models.MealLog

@{
    ViewBag.Title = "Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card p-4 shadow rounded-4">
        <h2 class="mb-4 text-info">Meal Details</h2>

        <dl class="row">
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

            <dt class="col-sm-3">Meal Type</dt>
            <dd class="col-sm-9">@Model.MealType</dd>

            <dt class="col-sm-3">Meal Type</dt>
            <dd class="col-sm-9">@Model.FoodItems</dd>

            <dt class="col-sm-3">Calories</dt>
            <dd class="col-sm-9">@Model.Calories</dd>

        </dl>

        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-warning me-2" })
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>



