@model GYM_Management_System.Models.WaterTntakeLog
@{
    ViewBag.Title = "Delete Water Intake";
}
<h2>Are you sure you want to delete this record?</h2>

<div class="card shadow-sm p-4 mt-3">
    <dl class="row">
        <dt class="col-sm-3">Date:</dt>
        <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

        <dt class="col-sm-3">Quantity (ml):</dt>
        <dd class="col-sm-9">@Model.AmountInMl</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    }
</div>

